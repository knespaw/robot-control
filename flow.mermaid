graph TD
%% 1. Node Definitions and Flow
    Start([Start Autonomous Navigation])

    subgraph Initialization [1. Pre-Loop: Target Acquisition]
        Capture1[Capture Initial Camera Frame]
        GDino[Grounding DINO Detects Target]
        TargetCoords[(Target Pixel Coordinates<br>Xt, Yt)]

        Capture1 --> GDino --> TargetCoords
    end

    Start --> Capture1

    subgraph ControlLoop [2. Real-Time Control Loop on Mac]
        CaptureN[Capture New Frame]
        YOLO[YOLO-World Detects Robot]
        RobotCoords[(Robot Pixel Coordinates<br>Xr, Yr)]

        CalcDistAngle[Calculate Distance & Angle to Target]
        CalcHeading[Calculate Robot Heading<br>using coordinate history]

        CheckArrived{Is Distance < Threshold?}

        CalcVel[Estimate Velocities<br>Linear V, Angular W]
        SendBLE[/Send V & W via Bluetooth/]

        CaptureN --> YOLO --> RobotCoords
        RobotCoords --> CalcDistAngle
        RobotCoords --> CalcHeading

        CalcDistAngle --> CheckArrived
        CalcHeading --> CheckArrived

        CheckArrived -- "No (Keep Moving)" --> CalcVel
        CalcVel --> SendBLE
    end

    TargetCoords --> CaptureN

    subgraph MegaPi [3. MegaPi Hardware Loop]
        RecvBLE[/Receive V & W/]
        DiffDrive[Calculate L/R Motor Speeds<br>Differential Drive Math]
        MoveMotors((Actuate Motors))

        RecvBLE --> DiffDrive --> MoveMotors
    end

    SendBLE --> RecvBLE

    MoveMotors -. "Robot moves, camera sees new position" .-> CaptureN

    CheckArrived -- "Yes (Target Reached)" --> StopRobot[Send V=0, W=0]
    StopRobot --> End([Navigation Complete])

%% 2. Styling Definitions
    classDef aiNode fill:#e3f2fd,stroke:#1e88e5,stroke-width:2px,color:#000
    classDef mathNode fill:#e8f5e9,stroke:#43a047,stroke-width:2px,color:#000
    classDef dataNode fill:#fff3e0,stroke:#fb8c00,stroke-width:2px,color:#000
    classDef hardNode fill:#eceff1,stroke:#546e7a,stroke-width:2px,color:#000
    classDef logicNode fill:#f3e5f5,stroke:#8e24aa,stroke-width:2px,color:#000
    classDef endpoint fill:#333,stroke:#fff,stroke-width:2px,color:#fff

%% 3. Applying Styles to Nodes
    class GDino,YOLO aiNode
    class CalcDistAngle,CalcHeading,CalcVel,DiffDrive mathNode
    class TargetCoords,RobotCoords dataNode
    class Capture1,CaptureN,SendBLE,RecvBLE,MoveMotors,StopRobot hardNode
    class CheckArrived logicNode
    class Start,End endpoint
