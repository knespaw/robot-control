graph TD
%% 1. Node Definitions and Flow
    subgraph ControlLoop [real-time control loop]
        CaptureN[GStreamer captures new frame]
        VidProc[frame pre-processing]

        Aruco["OpenCV detects ArUco marker position"]
        YOLO[YOLO-World detects: robot, target, obstacles]

        RobotCoords[(detected objects coordinates)]
        RefCoords[(ArUco marker position)]

        EmaSmoothing[apply EMA]

        CalcDistAngle[calculate distance to target]
        CalcHeading[calculate robot current heading]
        ApfCalc[calculate APF for obstacle avoidance]

        CalcActualHeading[calculate robot corrected heading]

        CheckArrived{target reached?}

        CalcVel[estimate adjusted velocities<br>Linear V, Angular W]

        SendBLE[/send V and W via Bluetooth/]

        CaptureN --> VidProc

        VidProc --> YOLO --> RobotCoords
        VidProc --> Aruco --> RefCoords

        RefCoords --> CalcHeading
        RobotCoords --> EmaSmoothing

        EmaSmoothing --> CalcDistAngle
        EmaSmoothing --> ApfCalc

        CalcDistAngle --> CheckArrived

       CalcHeading --> CalcActualHeading
       ApfCalc --> CalcActualHeading

        CalcActualHeading --> CheckArrived

        CheckArrived -- "nope" --> CalcVel
        CalcVel --> SendBLE
    end


    subgraph MegaPi [MegaPi hardware loop]
        RecvBLE[/receive V and W/]
        DiffDrive[calculate L/R motor speeds]
        MoveMotors((actuate motors))

        RecvBLE --> DiffDrive --> MoveMotors
    end

    SendBLE --> RecvBLE

    MoveMotors -. "robot moves, camera sees new position" .-> CaptureN

    CheckArrived -- "yup" --> StopRobot[send V=0, W=0]
    StopRobot --> End([target reached])

%% 2. Styling Definitions
    classDef aiNode fill:#e3f2fd,stroke:#1e88e5,stroke-width:2px,color:#000
    classDef mathNode fill:#e8f5e9,stroke:#43a047,stroke-width:2px,color:#000
    classDef dataNode fill:#fff3e0,stroke:#fb8c00,stroke-width:2px,color:#000
    classDef hardNode fill:#eceff1,stroke:#546e7a,stroke-width:2px,color:#000
    classDef logicNode fill:#f3e5f5,stroke:#8e24aa,stroke-width:2px,color:#000
    classDef endpoint fill:#333,stroke:#fff,stroke-width:2px,color:#fff

%% 3. Applying Styles to Nodes
    class YOLO,Aruco aiNode
    class EmaSmoothing,CalcActualHeading,ApfCalc,VidProc,CalcDistAngle,CalcHeading,CalcVel,DiffDrive mathNode
    class RefCoords,TargetCoords,RobotCoords dataNode
    class CaptureN,SendBLE,RecvBLE,MoveMotors,StopRobot hardNode
    class CheckArrived logicNode
    class Start,End endpoint
